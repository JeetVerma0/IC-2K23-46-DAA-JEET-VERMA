@startuml
skinparam defaultFontName sans-serif

title Doubly Linked List (DLL) Structure with Head and Tail Pointers

class DoublyLinkedList {
  - head: DLNode
  - tail: DLNode
  - _size: int
  + insert_at_position(data, pos)
  + delete_at_position(pos)
  + search(target): int
  + reverse()
}

class DLNode {
  + prev: DLNode
  + data: Any
  + next: DLNode
}

DoublyLinkedList o-- DLNode : head
DoublyLinkedList o-- DLNode : tail

rectangle "None" as LeftNull #Grey
rectangle "Node 0 (Head)\n[ prev | data: 10 | next ]" as D0 #LightCyan
rectangle "Node 1\n[ prev | data: 20 | next ]" as D1 #LightCyan
rectangle "Node 2 (Tail)\n[ prev | data: 30 | next ]" as D2 #LightCyan
rectangle "None" as RightNull #Grey

LeftNull <-left- D0 : prev
D0 -right-> D1 : next
D1 -left-> D0 : prev
D1 -right-> D2 : next
D2 -left-> D1 : prev
D2 -right-> RightNull : next

note bottom of D1
  Symmetry Invariants:
  node.next.prev == node
  node.prev.next == node
  Bidirectional O(1) boundary updates
end note

@enduml
