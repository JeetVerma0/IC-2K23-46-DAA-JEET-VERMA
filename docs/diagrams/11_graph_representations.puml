@startuml
skinparam defaultFontName sans-serif

title Graph Representations: Adjacency Matrix vs. Adjacency List

package "Reference Graph G = (V, E)" {
  rectangle "(0)" as V0 #LightSkyBlue
  rectangle "(1)" as V1 #LightSkyBlue
  rectangle "(2)" as V2 #LightSkyBlue
  rectangle "(3)" as V3 #LightSkyBlue

  V0 -right-> V1 : w=5
  V0 -down-> V2 : w=3
  V1 -down-> V3 : w=2
  V2 -right-> V3 : w=7
}

package "Adjacency Matrix (Dense V x V)" {
  rectangle "        Col 0  Col 1  Col 2  Col 3\nRow 0 |   0      5      3      0  |\nRow 1 |   0      0      0      2  |\nRow 2 |   0      0      0      7  |\nRow 3 |   0      0      0      0  |\n\nSpace: O(V^2)\nEdge Lookup: O(1)" as AdjMat #LightCyan
}

package "Adjacency List (Sparse V + E)" {
  rectangle "0 -> [(1, w=5), (2, w=3)]\n1 -> [(3, w=2)]\n2 -> [(3, w=7)]\n3 -> []\n\nSpace: O(V + E)\nIterate Neighbors: O(deg(u))" as AdjList #LightGoldenRodYellow
}

@enduml
