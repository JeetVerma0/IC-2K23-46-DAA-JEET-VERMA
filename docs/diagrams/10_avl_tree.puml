@startuml
skinparam defaultFontName sans-serif

title AVL Tree Self-Balancing Invariants and Rotations

package "Balanced AVL Node (BF in {-1, 0, 1})" {
  rectangle "Node [ 30 ]\nHeight: 3, BF: 0" as B30 #PaleGreen
  rectangle "Node [ 20 ]\nHeight: 2, BF: 0" as B20 #LightGreen
  rectangle "Node [ 40 ]\nHeight: 2, BF: 0" as B40 #LightGreen
  rectangle "Leaf [ 10 ]\nHeight: 1, BF: 0" as B10 #LightYellow
  rectangle "Leaf [ 25 ]\nHeight: 1, BF: 0" as B25 #LightYellow
  rectangle "Leaf [ 35 ]\nHeight: 1, BF: 0" as B35 #LightYellow
  rectangle "Leaf [ 50 ]\nHeight: 1, BF: 0" as B50 #LightYellow

  B30 --> B20
  B30 --> B40
  B20 --> B10
  B20 --> B25
  B40 --> B35
  B40 --> B50
}

package "Four AVL Rotation Primitives" {
  rectangle "LL Case (BF > 1, Left heavy)\n-> Right Rotation on Root" as LL #MistyRose
  rectangle "RR Case (BF < -1, Right heavy)\n-> Left Rotation on Root" as RR #MistyRose
  rectangle "LR Case (BF > 1, Right child heavy)\n-> Left Rotate Child, Right Rotate Root" as LR #Lavender
  rectangle "RL Case (BF < -1, Left child heavy)\n-> Right Rotate Child, Left Rotate Root" as RL #Lavender
}

note bottom of B10
  AVL Invariants:
  Balance Factor BF(X) = Height(Left) - Height(Right)
  Strict balance: |BF(X)| <= 1
  Guarantee: Height h <= 1.44 * log2(n)
  Lookup / Insert / Delete: Guaranteed O(log n)
end note

@enduml
