@startuml
skinparam defaultFontName sans-serif

title 1D Array Core Operations: Insertion, Deletion, and Linear Search

start

if (Operation Selected?) then (Insertion at pos k)
  :Validate index: 0 <= pos <= len(A);
  if (Valid?) then (Yes)
    :Append placeholder None to array A;
    :i = len(A) - 1;
    while (i > pos)
      :A[i] = A[i - 1] (Shift Right);
      :i = i - 1;
    endwhile
    :A[pos] = target_element;
    :Return success (Size increased);
  else (No)
    :Raise IndexError("Index out of range");
    stop
  endif

elseif (Deletion at pos k) then (Deletion at pos k)
  :Validate: len(A) > 0 and 0 <= pos < len(A);
  if (Valid?) then (Yes)
    :deleted_val = A[pos];
    :i = pos;
    while (i < len(A) - 1)
      :A[i] = A[i + 1] (Shift Left);
      :i = i + 1;
    endwhile
    :Pop duplicate tail slot;
    :Return deleted_val;
  else (No)
    :Raise IndexError;
    stop
  endif

else (Linear Search target)
  :i = 0, matches = [];
  while (i < len(A))
    if (A[i] == target) then (Yes)
      :Append i to matches;
    endif
    :i = i + 1;
  endwhile
  :Return matches list;
endif

stop
@enduml
