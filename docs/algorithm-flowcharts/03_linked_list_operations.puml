@startuml
skinparam defaultFontName sans-serif

title Linked List Core Operations: Insertion, Deletion, and In-Place Reversal

start

if (Operation?) then (Insert at Pos k)
  :Validate: 0 <= pos <= size;
  :Allocate new_node = Node(data);
  if (pos == 0) then (Head insertion)
    :new_node.next = head;
    :head = new_node;
  else (Internal / Tail)
    :curr = head;
    :Traverse curr for pos - 1 steps;
    :new_node.next = curr.next;
    :curr.next = new_node;
  endif
  :size = size + 1;
  stop

elseif (Delete at Pos k) then (Delete at Pos k)
  :Validate: head != None and 0 <= pos < size;
  if (pos == 0) then (Delete Head)
    :val = head.data;
    :head = head.next;
  else (Delete Middle / Tail)
    :curr = head;
    :Traverse curr to pos - 1;
    :target = curr.next;
    :val = target.data;
    :curr.next = target.next;
    :target.next = None;
  endif
  :size = size - 1;
  :Return val;
  stop

else (In-Place Reversal)
  :prev = None;
  :curr = head;
  while (curr != None)
    :next_node = curr.next (Preserve forward link);
    :curr.next = prev (Reverse direction);
    :prev = curr (Advance prev);
    :curr = next_node (Advance curr);
  endwhile
  :head = prev (Update head pointer);
  stop
endif

@enduml
