@startuml
skinparam defaultFontName sans-serif

title Graph Algorithms: BFS, DFS, and Dijkstra's Shortest Path

start

if (Algorithm?) then (BFS Traversal)
  :Initialize queue Q = [], visited = set();
  :Enqueue start_vertex, mark visited;
  while (Q not empty)
    :u = Q.dequeue();
    :Process / Record vertex u;
    for (each neighbor v of u)
      if (v not in visited) then (New node)
        :visited.add(v);
        :parent[v] = u;
        :Q.enqueue(v);
      endif
    endfor
  endwhile
  :Return BFS order & shortest hop paths;
  stop

elseif (DFS Traversal) then (DFS Traversal)
  :dfs(u, visited):;
  :Mark u visited, append to path;
  for (each neighbor v of u)
    if (v not in visited) then (Unvisited)
      :Recursive call dfs(v, visited);
    endif
  endfor
  stop

else (Dijkstra's Algorithm)
  :Initialize dist[v] = infinity for all v, dist[source] = 0;
  :Initialize min_heap PriorityQueue with (dist=0, source);
  while (min_heap not empty)
    :(d_u, u) = min_heap.pop_min();
    if (d_u > dist[u]) then (Stale entry)
      continue
    endif
    for (each neighbor v with weight w)
      :new_dist = dist[u] + w;
      if (new_dist < dist[v]) then (Relax Edge)
        :dist[v] = new_dist;
        :parent[v] = u;
        :min_heap.push((new_dist, v));
      endif
    endfor
  endwhile
  :Return shortest distances & shortest paths;
  stop
endif

@enduml
