@startuml
skinparam defaultFontName sans-serif

title Sorting (Merge / Quick Sort) and Binary Search Flowcharts

start

if (Algorithm?) then (Merge Sort)
  :merge_sort(A):;
  if (len(A) <= 1) then (Yes)
    :Return A;
    stop
  else (No)
    :mid = len(A) // 2;
    :left = merge_sort(A[0..mid-1]);
    :right = merge_sort(A[mid..n-1]);
    :Merge two sorted halves with pointers i, j;
    :Return combined sorted list;
    stop
  endif

elseif (Quick Sort) then (Quick Sort)
  :quick_sort(A, low, high):;
  if (low < high) then (Yes)
    :Select pivot (Median-of-three);
    :Partition: place smaller left, larger right;
    :pi = partition index;
    :quick_sort(A, low, pi - 1);
    :quick_sort(A, pi + 1, high);
  endif
  stop

else (Binary Search)
  :binary_search(A, target):;
  :low = 0, high = len(A) - 1;
  while (low <= high)
    :mid = low + (high - low) // 2;
    if (A[mid] == target) then (Found)
      :Return mid;
      stop
    elseif (A[mid] < target) then (Target is Right)
      :low = mid + 1;
    else (Target is Left)
      :high = mid - 1;
    endif
  endwhile
  :Return -1 (Not Found);
  stop
endif

@enduml
