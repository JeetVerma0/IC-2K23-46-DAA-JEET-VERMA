@startuml
skinparam defaultFontName sans-serif

title Circular Queue Operations and Round Robin Process Scheduler

start

if (Procedure?) then (Circular Queue Enqueue)
  if (_count == capacity) then (Full)
    :Raise OverflowError("Queue is Full");
    stop
  else (Space Available)
    :rear = (rear + 1) % capacity;
    :data[rear] = item;
    :_count = _count + 1;
    stop
  endif

elseif (Circular Queue Dequeue) then (Dequeue)
  if (_count == 0) then (Empty)
    :Raise IndexError("Queue is Empty");
    stop
  else (Has Items)
    :val = data[front];
    :data[front] = None;
    :front = (front + 1) % capacity;
    :_count = _count - 1;
    :Return val;
    stop
  endif

else (Round Robin Scheduling)
  :Set time_quantum q, current_time = 0;
  :Initialize ready_queue with arrived processes;
  while (Processes pending OR ready_queue not empty)
    if (ready_queue is empty) then (CPU Idle)
      :Advance current_time to next arrival;
      :Enqueue arriving processes;
    endif
    :P = ready_queue.dequeue();
    :exec_time = min(q, P.remaining_time);
    :current_time = current_time + exec_time;
    :P.remaining_time -= exec_time;
    :Enqueue any newly arrived processes during [t, t+exec];
    if (P.remaining_time == 0) then (Finished)
      :P.completion_time = current_time;
      :P.turnaround_time = CT - P.arrival_time;
      :P.waiting_time = TAT - P.burst_time;
    else (Not Finished)
      :ready_queue.enqueue(P);
    endif
  endwhile
  :Compute average TAT and WT;
  stop
endif

@enduml
