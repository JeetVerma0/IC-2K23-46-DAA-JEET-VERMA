@startuml
skinparam defaultFontName sans-serif

title Infix-to-Postfix (Shunting-Yard) and Postfix Evaluation

start

if (Subroutine?) then (Infix to Postfix)
  :Initialize operator_stack = [], output = [];
  :Tokenize expression;
  while (Tokens remain?)
    :Read token T;
    if (T is Operand) then (Yes)
      :Append T to output;
    elseif (T == '(') then (Open paren)
      :Push '(' to operator_stack;
    elseif (T == ')') then (Close paren)
      while (stack.top != '(')
        :Append stack.pop() to output;
      endwhile
      :stack.pop() (Discard '(');
    else (Operator op)
      while (stack not empty AND\nprecedence(stack.top) >= precedence(op) AND\nop is LeftAssociative)
        :Append stack.pop() to output;
      endwhile
      :Push op to operator_stack;
    endif
  endwhile
  while (stack not empty)
    :Append stack.pop() to output;
  endwhile
  :Return postfix tokens;
  stop

else (Postfix Evaluation)
  :Initialize operand_stack = [];
  while (Postfix tokens remain?)
    :Read token T;
    if (T is Numeric Operand) then (Yes)
      :Push float/int(T) to operand_stack;
    else (Operator op)
      :b = operand_stack.pop();
      :a = operand_stack.pop();
      :Compute result = apply_op(op, a, b);
      :Push result to operand_stack;
    endif
  endwhile
  :Return operand_stack.pop();
  stop
endif

@enduml
