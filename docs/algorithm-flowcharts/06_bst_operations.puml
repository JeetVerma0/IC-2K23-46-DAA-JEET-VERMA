@startuml
skinparam defaultFontName sans-serif

title Binary Search Tree (BST) Operations: Insert, Search, and Delete

start

if (Operation?) then (BST Insert key)
  :insert(node, key):;
  if (node is None) then (Base)
    :Return TreeNode(key);
  elseif (key == node.key) then (Duplicate)
    :Raise ValueError("Duplicate keys prohibited");
  elseif (key < node.key) then (Go Left)
    :node.left = insert(node.left, key);
  else (Go Right)
    :node.right = insert(node.right, key);
  endif
  :Return node;
  stop

elseif (BST Search key) then (Search key)
  :search(node, target):;
  if (node is None or node.key == target) then (Found/None)
    :Return node;
  elseif (target < node.key) then (Left)
    :Return search(node.left, target);
  else (Right)
    :Return search(node.right, target);
  endif
  stop

else (BST Delete key)
  :delete(node, key):;
  if (key < node.key) then (Descend Left)
    :node.left = delete(node.left, key);
  elseif (key > node.key) then (Descend Right)
    :node.right = delete(node.right, key);
  else (Key Found! Inspect Children)
    if (node is Leaf) then (Case 1: No child)
      :Return None;
    elseif (node has 1 child) then (Case 2: Single child)
      :Return non-null child;
    else (Case 3: Two children)
      :succ = find_min(node.right) (Inorder successor);
      :node.key = succ.key;
      :node.right = delete(node.right, succ.key);
    endif
  endif
  :Return node;
  stop
endif

@enduml
