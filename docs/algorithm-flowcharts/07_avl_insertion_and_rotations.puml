@startuml
skinparam defaultFontName sans-serif

title AVL Tree Self-Balancing: Insertion and Rotation Dispatch

start

:insert_avl(node, key):;
if (node is None) then (Empty spot)
  :Return AVLNode(key, height=1);
  stop
elseif (key < node.key) then (Left)
  :node.left = insert_avl(node.left, key);
elseif (key > node.key) then (Right)
  :node.right = insert_avl(node.right, key);
else (Duplicate)
  :Raise ValueError("Duplicate prohibited");
  stop
endif

:node.height = 1 + max(h(node.left), h(node.right));
:balance = h(node.left) - h(node.right);

if (balance > 1 AND key < node.left.key) then (LL Imbalance)
  :Perform Right Rotation on node;
  :Return rotated root;
  stop
elseif (balance < -1 AND key > node.right.key) then (RR Imbalance)
  :Perform Left Rotation on node;
  :Return rotated root;
  stop
elseif (balance > 1 AND key > node.left.key) then (LR Imbalance)
  :node.left = Left Rotation(node.left);
  :Perform Right Rotation on node;
  :Return rotated root;
  stop
elseif (balance < -1 AND key < node.right.key) then (RL Imbalance)
  :node.right = Right Rotation(node.right);
  :Perform Left Rotation on node;
  :Return rotated root;
  stop
else (Balanced: |balance| <= 1)
  :Return node;
  stop
endif

@enduml
